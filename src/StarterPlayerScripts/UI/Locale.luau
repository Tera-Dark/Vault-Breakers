function Locale.text(language: string, key: string, args: any?): string
	local dictionary = strings[language] or strings.en
	local text = dictionary[key] or strings.en[key] or key
	return (string.gsub(text, "{(%w+)}", function(name) return tostring(if args then args[name] or "" else "") end))
end
return Locale
